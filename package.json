{
  "name": "universal-graceful-exit",
  "version": "1.1.7",
  "repository": {
    "type": "git",
    "url": "https://github.com/pavelsc/universal-graceful-exit"
  },
  "description": "Zero-dependency universal lifecycle manager and socket buffer flusher for Node.js",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "import": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 0",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "pre-commit": "npm run lint:check && npm run format:fix"
  },
  "keywords": [
    "graceful",
    "shutdown",
    "exit",
    "socket",
    "buffer",
    "amqplib",
    "redis",
    "unhandledRejection"
  ],
  "author": "Pavel K",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "17.16.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
