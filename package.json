{
  "name": "universal-graceful-exit",
  "version": "2.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/pavelsc/universal-graceful-exit"
  },
  "description": "Zero-dependency universal lifecycle manager and socket buffer flusher for Node.js",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "import": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "jest --runInBand",
    "test:loud": "node -r ./tests/loud-env.js ./node_modules/jest/bin/jest.js --runInBand",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "pre-commit": "npm run lint:check && npm run format:fix && npm run test:loud"
  },
  "keywords": [
    "graceful",
    "shutdown",
    "exit",
    "socket",
    "buffer",
    "amqplib",
    "redis",
    "unhandledRejection",
    "pm2",
    "docker",
    "kubernetes",
    "lifecycle",
    "writableLength",
    "diagnostics_channel",
    "websockets"
  ],
  "author": "Pavel K",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "17.16.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6"
  }
}
